# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=

# Claude binary path (optional, defaults to claude in PATH)
# CLAUDE_PATH=/usr/local/bin/claude

# Seed user: bridge:userId for initial workspace migration
# SEED_USER=discord:YOUR_USER_ID

# Session TTL in minutes (default: 60)
SESSION_TTL_MINUTES=60

# Max concurrent Claude processes (default: 3)
MAX_CONCURRENCY=3

# Claude timeout in milliseconds (default: 300000 = 5 min)
CLAUDE_TIMEOUT=300000

# Auto-compact: token threshold before session rotation (default: 80000)
COMPACT_THRESHOLD=80000

# AI Provider: claude-api | claude-cli (default: claude-api)
AI_PROVIDER=claude-api

# Anthropic API key (required for claude-api)
ANTHROPIC_API_KEY=sk-ant-...

# Claude CLI path (only needed when AI_PROVIDER=claude-cli, for personal/dev use)
# CLAUDE_PATH=/usr/local/bin/claude

# Security admin Discord user ID (receives violation alerts)
# SECURITY_ADMIN_ID=

# --- Web Dashboard ---
# Set WEB_PORT to enable the web dashboard
# WEB_PORT=3001
# WEB_PUBLIC_URL=https://your-name.ngrok-free.app  # Full public URL (for ngrok/tunnel)
# WEB_PUBLIC_HOST=192.168.1.100                     # Or just the host (for LAN access)
# WEB_TOKEN_TTL=1800000                             # Web token TTL ms (default: 30min)
# WEB_SESSION_TTL=1800000                           # Web session TTL ms (default: 30min)

# --- ngrok tunnel (auto-managed by ctl.sh) ---
# NGROK_DOMAIN=auto                        # "auto" = dynamic URL (free tier)
#             =external                    # don't start ngrok, detect URL from existing agent
#             =your-name.ngrok-free.app    # use a static domain

# --- Google Drive (optional) ---
# Enables /drive-connect for users to link their workspace to Google Drive.
# 1. Create a project at https://console.cloud.google.com/
# 2. Enable Drive, Docs, Sheets, Slides APIs
# 3. Create OAuth 2.0 credentials → type "Web application"
# 4. Add redirect URI: https://YOUR_DOMAIN/drive-auth/callback
# 5. Download JSON → save as gcp-oauth.keys.json
# GDRIVE_OAUTH_KEYS_PATH=/path/to/gcp-oauth.keys.json

# --- Text-to-Speech (optional) ---
# Enables /speak to convert workspace notes (.md/.txt) to audio.
# TTS_PROVIDER=google   # google (default) | openai

# Google Cloud TTS — zh-TW voices, 1M chars/month free (Neural2/WaveNet)
# 1. Enable "Cloud Text-to-Speech API" in https://console.cloud.google.com/
# 2. Create an API key (APIs & Services -> Credentials), restrict to that API
# GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE=cmn-TW-Wavenet-A   # cmn-TW-Wavenet-B/C, cmn-TW-Standard-A/B/C

# OpenAI TTS — auto language detection, no free tier (~$0.015/min on gpt-4o-mini-tts)
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts    # or tts-1 / tts-1-hd
# OPENAI_TTS_VOICE=alloy              # alloy, echo, fable, onyx, nova, shimmer, ...

# Audio chunks are merged into one file via ffmpeg (falls back to raw concat if ffmpeg
# is not installed). Output is split into multiple files only if merged size > 10MB.
