# Path to claude CLI (optional, defaults to claude in PATH)
# CLAUDE_PATH=/usr/local/bin/claude

# Project root (working directory for jobs)
# PROJECT_DIR=/path/to/synapsis

# AI Provider: claude-cli | claude-api (default: claude-cli)
AI_PROVIDER=claude-cli

# Anthropic API key (required only when AI_PROVIDER=claude-api)
# ANTHROPIC_API_KEY=sk-ant-...

# Set to any value to enable debug logging
# DEBUG=1
